# .env.example for Render deployment
# Copy this file to .env in Render's Environment Variables section

# FastAPI settings (auto‑filled by Dockerfile, do not change)
HOST=0.0.0.0
PORT=10000
FRONTEND_URL=https://shadow-ai-guard.vercel.app

# Application secrets
SECRET_KEY=a_very_secret_key_for_shadow_ai_guard_123!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Gemini API key (required for AI features)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# PostgreSQL connection (Render provides DATABASE_URL automatically if you add a PostgreSQL add‑on)
# If you created a Postgres service, use its URL:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=YOUR_POSTGRESQL_CONNECTION_STRING

# CORS origins (adjust if needed)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://shadow-ai-guard.vercel.app"
